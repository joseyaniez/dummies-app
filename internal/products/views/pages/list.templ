package pages

import "github.com/joseyanez/dummies-app/internal/common/views/layouts"
import "github.com/joseyanez/dummies-app/internal/products/models"

templ ListProductsPage(products []*models.Product) {
  @layouts.AdminLayout("Mis productos"){
    <h1 class="text-3xl font-bold mt-4 mb-6">Lista de productos</h1>
    <div class="flex justify-end my-4">
      <a href="/admin/products/create"
        class="bg-bluemmy-500 hover:bg-bluemmy-700 text-white font-bold py-1 px-2 rounded"
      >
        Nuevo producto
      </a>
    </div>
    if products != nil {
      <div>
        for _, prod := range products {
          <div class="w-full px-4 my-2 flex flex-row items-center bg-white h-28 rounded shadow-sm shadow-bluemmy-200">
            <div class="w-12 text-md font-bold flex justify-center items-center">
              {prod.Id}
            </div>
            <div class="flex-1 flex flex-col gap-2">
              <p class="text-xl font-bold">{prod.Title}</p>
              <div class="flex flex-row gap-2">
                <p class="text-md bg-bluemmy-300 rounded-full px-2">S/.{prod.Price}</p>
                <a href={"/admin/products/" + prod.Id}>Ver</a>
                <a href={"/admin/products/edit/" + prod.Id}>Editar</a>
              </div>
            </div>
            if prod.Description != ""{
              <div class="flex-1 mx-2 hidden sm:flex">
                {prod.Description}
              </div>
            }
            <div class="hidden flex-1 md:flex flex-row justify-end gap-2">
              if len(prod.Images) > 0 {
                  for _, img := range prod.Images {
                    <img class="block rounded h-20 w-auto" src={"/static/images/" + img} alt={prod.Title}>
                  }
              }
            </div>
          </div>
        }
      </div>
    } else {
      <div class="p-4 my-2 w-full bg-bluemmy-200 border border-md border-bluemmy-400  rounded-md">No hay productos ahora</div>
    }
  }
}
